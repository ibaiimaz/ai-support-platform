{
  "name": "ai-support-platform",
  "version": "1.0.0",
  "description": "Proyecto educativo backend para explorar aplicaciones que integran LLM mediante iteraciones pequeñas y especificaciones revisadas antes de implementar.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "start": "node dist/src/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "verify": "npm run format:check && npm run lint && npm test",
    "eval:classification": "node dist/src/evaluation/main.js",
    "eval:compare": "node dist/src/evaluation/compare-main.js",
    "eval:model-comparison": "node dist/src/evaluation/model-comparison/main.js",
    "eval:models:compare": "node dist/src/evaluation/model-comparison/compare-main.js",
    "eval:independent": "node dist/src/evaluation/independent-validation/launch.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.5",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  }
}
